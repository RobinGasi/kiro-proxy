[
  {
    "type": "refresh_token",
    "refresh_token": "your-refresh-token-here",
    "profile_arn": "arn:aws:codewhisperer:us-east-1:123456789012:profile/ABCDEF",
    "region": "us-east-1"
  },
  {
    "type": "json",
    "path": "/path/to/kiro-ide-credentials.json"
  },
  {
    "type": "sqlite",
    "path": "/home/user/.local/share/kiro-cli/data.sqlite3",
    "api_region": "us-east-1"
  }
]

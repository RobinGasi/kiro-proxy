# ==========================================================================
# kiro-proxy configuration (copy to .env)
# OpenAI- and Anthropic-compatible proxy for Kiro / Amazon Q / CodeWhisperer.
# ==========================================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Proxy auth (clients send this) ---
# OpenAI style:    Authorization: Bearer <PROXY_API_KEY>
# Anthropic style: x-api-key: <PROXY_API_KEY>
# Multiple keys supported: comma or whitespace separated.
PROXY_API_KEY=my-super-secret-password-123

# --- Credentials: pick ONE method ---
# 1) Direct refresh token (+ optional profile ARN). PROFILE_ARN is REQUIRED for
#    most accounts on the current runtime.kiro.dev endpoint.
REFRESH_TOKEN=
PROFILE_ARN=

# 2) Kiro IDE JSON credentials file.
KIRO_CREDS_FILE=

# 3) kiro-cli SQLite database (AWS SSO / Builder ID / corporate IdC).
#    Default: ~/.local/share/kiro-cli/data.sqlite3
KIRO_CLI_DB_FILE=
# Recommended true when sharing the DB with a running kiro-cli (avoids the
# refresh-token rotation race).
SQLITE_READONLY=false

# --- Regions ---
# KIRO_REGION is the SSO/auth (OIDC) region. KIRO_API_REGION overrides the Q API
# region when it differs (auto-detected from the profile ARN otherwise).
KIRO_REGION=us-east-1
KIRO_API_REGION=

# --- Network ---
# HTTP/HTTPS/SOCKS5 proxy for restricted networks (China GFW, corporate).
VPN_PROXY_URL=

# --- Multi-account failover (optional) ---
ACCOUNT_SYSTEM=false
ACCOUNTS_CONFIG_FILE=credentials.json
ACCOUNTS_STATE_FILE=state.json

# --- Behaviour ---
LOG_LEVEL=INFO
DEBUG_MODE=off            # off | errors | all
TRUNCATION_RECOVERY=true
WEB_SEARCH_ENABLED=true
FAKE_REASONING=true
FAKE_REASONING_MAX_TOKENS=4000
FAKE_REASONING_BUDGET_CAP=10000
FIRST_TOKEN_TIMEOUT=15
STREAMING_READ_TIMEOUT=300
FIRST_TOKEN_MAX_RETRIES=3
KIRO_MAX_PAYLOAD_BYTES=600000
AUTO_TRIM_PAYLOAD=false

# Spoofed Kiro IDE client version sent in the User-Agent (bump as the real
# client advances to avoid version checks).
KIRO_CLIENT_VERSION=0.7.45
